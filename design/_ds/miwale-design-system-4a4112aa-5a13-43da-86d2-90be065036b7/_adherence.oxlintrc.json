{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/motion/**",
              "components/navigation/**",
              "components/playful/**",
              "components/scroll/**",
              "components/surfaces/**",
              "components/text/**",
              "ui_kits/studio_app/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Quicksand|Manrope|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Quicksand, Manrope, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnimatedBeam'] > JSXAttribute > JSXIdentifier[name!=/^(?:containerRef|fromRef|toRef|curvature|reverse|duration|delay|startXOffset|startYOffset|endXOffset|endYOffset|color|trackColor|width|key|ref|className|style|children)$/]",
        "message": "<AnimatedBeam> doesn't accept that prop. Declared props: containerRef, fromRef, toRef, curvature, reverse, duration, delay, startXOffset, startYOffset, endXOffset, endYOffset, color, trackColor, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:imageUrl|profileUrl|name|key|ref|className|style|children)$/]",
        "message": "<AvatarEntry> doesn't accept that prop. Declared props: imageUrl, profileUrl, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='Backlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|blur|opacity|glow|radius|className|style|key|ref|className|style|children)$/]",
        "message": "<Backlight> doesn't accept that prop. Declared props: children, blur, opacity, glow, radius, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|aqua|navy|success|warning|danger|glass)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'aqua' | 'navy' | 'success' | 'warning' | 'danger' | 'glass'."
      },
