---
import { ClientRouter } from 'astro:transitions';
import Ocean from '../components/Ocean.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Vorentwurf: bis zum Launch bleibt die Seite aus dem Index. */
  noindex?: boolean;
}

const { title, description, noindex = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://miwale.com');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/png" href="/assets/mascot-whale.png" />
    <meta name="theme-color" content="#050a16" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="miwale" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/assets/logo-wordmark.png', canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />
  </head>

  <body>
    <a class="mw-skip" href="#inhalt">Zum Inhalt springen</a>

    <Ocean />

    <div class="mw-shell">
      <Header />
      <main id="inhalt">
        <slot />
      </main>
      <Footer />
    </div>

    <BottomNav />

    <script>
      import { initOcean, bindOcean } from '../scripts/ocean';

      bindOcean();
      initOcean();
      // Nach jedem Seitenwechsel neu verdrahten – der Ozean selbst bleibt
      // dank transition:persist stehen, die Reveal-Ziele sind aber neu.
      document.addEventListener('astro:page-load', initOcean);
    </script>
  </body>
</html>
