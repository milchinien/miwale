---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GlassCard from '../../components/ds/GlassCard.astro';
import Tag from '../../components/ds/Tag.astro';

export async function getStaticPaths() {
  const posts = await getCollection('devlog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'devlog'> };

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Base title={`${post.data.title} — miwale Devlog`} description={post.data.summary}>
  <section class="mw-section">
    <div class="mw-wrap mw-narrow">
      <a class="mw-back" href="/devlog/">&larr; Alle Einträge</a>
      <time class="mw-post__date" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      <h1 class="mw-h1">{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <div class="mw-tags mw-mt-sm">{post.data.tags.map((t) => <Tag>{t}</Tag>)}</div>
      )}
    </div>
  </section>

  <section class="mw-section">
    <div class="mw-wrap mw-narrow">
      <GlassCard pad="lg">
        <article class="mw-prose"><Content /></article>
      </GlassCard>
    </div>
  </section>
</Base>
