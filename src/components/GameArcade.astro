---
const games = [
  { id: 'chromatic', name: 'Chromatic', kind: 'Roguelite-Deckbuilder', url: 'https://milchinien.github.io/Chromatic/' },
  { id: 'wavebreaker', name: 'Wavebreaker', kind: 'Idle-Verteidigung', url: 'https://milchinien.github.io/Wavebreaker/' },
  { id: 'runecall', name: 'Runecall', kind: 'Karten-Prototyp', url: 'https://milchinien.github.io/Runecall/' },
  { id: 'dropfall', name: 'Dropfall', kind: 'Physik-Incremental', url: 'https://milchinien.github.io/Dropfall/' },
  { id: 'harmonics', name: 'Harmonics', kind: 'Himmelsmechanik-Prototyp', url: 'https://milchinien.github.io/Harmonics/' },
];
---

<section class="mw-arcade" aria-labelledby="arcade-title" data-game-arcade>
  <div class="mw-arcade__head">
    <div>
      <p class="mw-eyebrow">Direkt spielen</p>
      <h2 class="mw-h2" id="arcade-title">Fünf Spiele, keine Installation</h2>
    </div>
    <p class="mw-lead">Spiel auswählen und direkt auf dieser Seite starten.</p>
  </div>

  <div class="mw-arcade__grid">
    {games.map((game) => (
      <button class="mw-game" type="button" data-game-url={game.url} data-game-name={game.name}>
        <span class="mw-game__name">{game.name}</span>
        <span class="mw-game__kind">{game.kind}</span>
        <span class="mw-game__play">Jetzt spielen <span aria-hidden="true">→</span></span>
      </button>
    ))}
  </div>

  <dialog class="mw-player" data-game-dialog aria-labelledby="game-player-title">
    <div class="mw-player__bar">
      <strong id="game-player-title" data-game-title>Browserspiel</strong>
      <button type="button" class="mw-player__close" data-game-close>Spiel schließen <span aria-hidden="true">×</span></button>
    </div>
    <iframe data-game-frame src="about:blank" title="Browserspiel" allow="autoplay; fullscreen"></iframe>
  </dialog>
</section>

<script>
  function initGameArcades() {
    document.querySelectorAll<HTMLElement>('[data-game-arcade]').forEach((arcade) => {
      if (arcade.dataset.ready === 'true') return;
      arcade.dataset.ready = 'true';
      const dialog = arcade.querySelector<HTMLDialogElement>('[data-game-dialog]');
      const frame = arcade.querySelector<HTMLIFrameElement>('[data-game-frame]');
      const title = arcade.querySelector<HTMLElement>('[data-game-title]');
      if (!dialog || !frame || !title) return;

      const close = () => {
        dialog.close();
        frame.src = 'about:blank';
        document.documentElement.classList.remove('mw-game-open');
      };

      arcade.querySelectorAll<HTMLButtonElement>('[data-game-url]').forEach((button) => {
        button.addEventListener('click', () => {
          const name = button.dataset.gameName || 'Browserspiel';
          title.textContent = name;
          frame.title = name;
          frame.src = button.dataset.gameUrl || 'about:blank';
          dialog.showModal();
          document.documentElement.classList.add('mw-game-open');
        });
      });
      arcade.querySelector('[data-game-close]')?.addEventListener('click', close);
      dialog.addEventListener('cancel', (event) => { event.preventDefault(); close(); });
      dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    });
  }
  document.addEventListener('astro:page-load', initGameArcades);
  initGameArcades();
</script>

<style>
  .mw-arcade{width:min(1200px,calc(100% - 40px));margin:0 auto 72px;padding:28px;border:1px solid rgba(127,224,238,.22);border-radius:28px;background:rgba(4,25,36,.66);box-shadow:0 24px 70px rgba(0,8,14,.3)}
  .mw-arcade__head{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:24px}.mw-arcade__head .mw-lead{max-width:34ch;margin:0}
  .mw-arcade__grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
  .mw-game{text-align:left;min-height:170px;padding:20px;border:1px solid rgba(127,224,238,.22);border-radius:19px;background:linear-gradient(155deg,rgba(63,198,220,.15),rgba(255,255,255,.04));color:#fff;cursor:pointer;display:flex;flex-direction:column;transition:transform .2s ease,border-color .2s ease,background .2s ease}
  .mw-game:hover,.mw-game:focus-visible{transform:translateY(-4px);border-color:rgba(127,224,238,.65);background:linear-gradient(155deg,rgba(63,198,220,.25),rgba(255,255,255,.07))}.mw-game:focus-visible{outline:2px solid #7fe0ee;outline-offset:3px}
  .mw-game__name{font:700 1.2rem/1.2 var(--font-display,system-ui);margin-bottom:7px}.mw-game__kind{font-size:.82rem;line-height:1.45;color:rgba(237,243,249,.65)}.mw-game__play{margin-top:auto;padding-top:20px;font-size:.78rem;font-weight:750;letter-spacing:.05em;text-transform:uppercase;color:#7fe0ee}
  .mw-player{width:calc(100vw - 28px);height:calc(100dvh - 28px);max-width:none;max-height:none;margin:auto;padding:0;border:1px solid rgba(127,224,238,.3);border-radius:22px;overflow:hidden;background:#031018;color:#fff}.mw-player::backdrop{background:rgba(1,8,13,.9);backdrop-filter:blur(14px)}
  .mw-player__bar{height:62px;padding:0 18px;display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid rgba(127,224,238,.2);background:#06202c}.mw-player__close{padding:9px 14px;border:1px solid rgba(255,255,255,.2);border-radius:999px;background:rgba(255,255,255,.08);color:#fff;font:inherit;font-size:.85rem;cursor:pointer}.mw-player iframe{display:block;width:100%;height:calc(100% - 62px);border:0;background:#02080d}.mw-game-open{overflow:hidden}
  @media(max-width:950px){.mw-arcade__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.mw-game:last-child{grid-column:1/-1}.mw-arcade__head{align-items:start;flex-direction:column}}
  @media(max-width:560px){.mw-arcade{width:calc(100% - 24px);padding:18px;margin-bottom:48px}.mw-arcade__grid{grid-template-columns:1fr}.mw-game:last-child{grid-column:auto}.mw-game{min-height:126px}.mw-player{width:100vw;height:100dvh;border:0;border-radius:0}.mw-player__bar{height:56px;padding:0 12px}.mw-player__close{font-size:.76rem}.mw-player iframe{height:calc(100% - 56px)}}
  @media(prefers-reduced-motion:reduce){.mw-game{transition:none}}
</style>
