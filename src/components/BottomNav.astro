---
import { NAV, isActive } from '../nav';
const path = Astro.url.pathname;
---

<nav class="mw-bottomnav-wrap" aria-label="Hauptnavigation (mobil)" transition:persist="bottomnav">
  <div class="mw-bottomnav">
    {NAV.map((item) => (
      <a
        class:list={['mw-bottomnav__item', isActive(item.href, path) && 'mw-bottomnav__item--on']}
        href={item.href}
        aria-current={isActive(item.href, path) ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={item.icon} />
        </svg>
        <span>{item.short}</span>
      </a>
    ))}
  </div>
</nav>
